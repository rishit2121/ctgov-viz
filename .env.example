# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- Planner LLM (Claude by default) -----------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Only needed if your key is NOT scoped to a workspace (the API error tells you so):
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=high            # low | medium | high | xhigh | max

# Alternatives:
# LLM_MODE=fake                    # offline: answers only the example questions in examples/plans
# LLM_MODE=openai
# OPENAI_API_KEY=sk-...

# --- Retrieval limits (defaults shown) -----------------------------------------------------
# MAX_STUDIES_PER_COHORT=20000
# REQUEST_DEADLINE_S=90
# CTGOV_CONCURRENCY=3
